<!doctype html>
<html lang="en">

<head>
    {% include "meta.liquid" %}
    <title>(LFE:{{ page.title }})</title>
    <meta name="description" content="{{ page.description }}">

    {% include "favicon.liquid" %}
    {% include "css.liquid" %}
</head>

<body class="min-h-[75rem]">
    <header class="top-nav">
    {% include "nav.liquid" %}
    </header>

    <main id="content" role="main" tabindex="-1" class="flex-shrink-0 plan-page">
        <div class="masthead-container">
            <div class="masthead-section">
                <h1 class="page-title">{{ page.data.long_title }}</h1>
                <h2 class="page-description">{{ page.data.long_description }}</h2>
            </div>
        </div>
        <div class="content-section editorial-prose plan-page-content">
            {{ page.content }}
        </div>
    </main>

    {% include "foot.liquid" %}

    {% include "end-scripts.liquid" %}
</body>

</html>
