<!-- Card Blog -->
<div class="max-w-[80rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 mx-auto">
  <div class="flex w-full justify-center">
    <h2>{{ site.data.home.videos.title }}</h2>
  </div>

  <p class="mt-3 text-lfe-primary">
  </p>

  <!-- Grid -->
  <div class="video-cards grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {% for video in site.data.home.videos.items %}
    <!-- Card -->
    <div
      class="group flex flex-col h-full bg-lfe-panel border border-lfe-boundary shadow-sm rounded-md">
      <div class="max-h-52 aspect-[16/9] flex flex-col justify-center items-center bg-lfe-raised rounded-t-md">
        {{ video.content_html }}
      </div>
      <div class="p-4 md:p-6">
        <span class="block mb-1 text-xs font-semibold uppercase text-lfe-link">
          {{ video.service_name }}
        </span>
        <h3 class="text-xl font-semibold text-lfe-primary">
          {{ video.title }}
        </h3>
        <p class="mt-3 text-lfe-muted">
          {{ video.venue }} with {{ video.speaker }}
        </p>
      </div>
      <div
        class="mt-auto flex border-t border-lfe-boundary divide-x divide-lfe-boundary">
        <div class="card-button card-action"><a class="w-full py-3 px-4 inline-flex justify-center items-center gap-2 rounded-bl-md font-medium cta-gold shadow-sm align-middle transition-all text-sm sm:p-4"
          href="{{ video.link_url }}">
          {{ video.link_text }}
          </a>
        </div>
        <div class="card-button">
        <a class="w-full py-3 px-4 inline-flex justify-center items-center gap-2 rounded-br-md font-medium bg-lfe-panel text-lfe-primary shadow-sm align-middle hover:bg-lfe-raised transition-all text-sm sm:p-4"
          href="{{ video.channel_url }}">
          {{ video.channel_text }}
        </a>
        </div>
      </div>
    </div>
    <!-- End Card -->
    {% endfor %}

  </div>
  <!-- End Grid -->
</div>
<!-- End Card Blog -->
