<div class="masthead-container">
  <div class="masthead-section">

    <h1 class="home-title">{{ page.title }}</h1>

    <em id="lfe-tagline" class="tagline">"{{ site.data.home.masthead.sitetagline }}"</em>

    <div class="masthead-summary">
      {{ site.data.home.masthead.summary.content_html }}
      <a href="{{ site.data.home.masthead.summary.link_url }}" class="cta-gold masthead-summary-link inline-flex justify-center items-center gap-2 rounded-md border border-transparent font-semibold transition-all text-sm">
        {{ site.data.home.masthead.summary.link_text }} &raquo;
      </a>
    </div>

    <div class="flex justify-center">
      <div class="max-w-[60rem]">
        <div class="border rounded-md shadow-sm p-0 bg-lfe-panel border-lfe-boundary">

          <!-- tabs -->
          <div class="border-b bg-lfe-raised border-lfe-boundary">
            <nav id="lfe-excerpt-tabs" class="-mb-0.5 flex justify-center space-x-4 md:space-x-6 flex-wrap md:flex-nowrap" aria-label="Language examples" role="tablist">

              {% for excerpt in site.data.home.excerpts.items %}
              <button type="button"
                class="tab-gold py-1 md:py-4 px-1 inline-flex items-center gap-2 border-b-[3px] text-sm whitespace-nowrap {% if forloop.index == 1 %}active{% endif %}"
                id="horizontal-alignment-item-{{ excerpt.id }}"
                aria-controls="horizontal-alignment-{{ excerpt.id }}" aria-selected="{% if forloop.index == 1 %}true{% else %}false{% endif %}" tabindex="{% if forloop.index == 1 %}0{% else %}-1{% endif %}" role="tab">
                {{ excerpt.name }}
              </button>

              {% endfor %}
            </nav>
          </div>

          <!-- tabbed content -->
          <div class="mt-0 bg-lfe-panel">

            {% for excerpt in site.data.home.excerpts.items %}
            <div id="horizontal-alignment-{{ excerpt.id }}" class="excerpt-panel{% if forloop.index != 1 %} hidden{% endif %}" role="tabpanel" tabindex="0"
              aria-labelledby="horizontal-alignment-item-{{ excerpt.id }}">
              <div class="grid grid-cols-1 md:grid-cols-3 md:gap-4">
                <div class="md:col-span-2 bg-lfe-code-surface">
                  {{ excerpt.code_html }}
                </div>
                <div class="code-description px-4 py-2 md:pr-2">
                  {{ excerpt.desc_html }}
                </div>
              </div>
            </div>

            {% endfor %}

          </div>
        </div>

      </div>
    </div> <!-- center justification wrapper -->

  </div>
</div>
