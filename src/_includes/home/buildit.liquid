<!-- What You Can Build Section -->

<div class="max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 mx-auto">
  <!-- Grid -->
  <div class="buildit grid md:grid-cols-3 gap-12">
    <div class="lg:w-3/4">
      <h2 class="text-3xl text-lfe-primary font-bold lg:text-4xl">
        {{ site.data.home.buildit.title_html }}
      </h2>
    </div>
    <!-- End Col -->

    <div class="space-y-6 lg:space-y-10 col-span-2">

      {% for build in site.data.home.buildit.items %}
      <!-- Block -->
      <div class="flex buildit-card">
        <div class="ml-5 sm:ml-8">
          <h3 class="text-base sm:text-lg font-semibold text-lfe-primary">
            {{ build.title }}
          </h3>
          <div class="mt-1 text-lfe-secondary">
            {{ build.content_html }}
            <div class="mt-3 flex justify-end">
              <a href="{{ build.link_url }}"
              class="inline-flex justify-center items-center gap-2 rounded-md border border-transparent py-2 px-3 font-semibold bg-lfe-action-secondary text-lfe-action-secondary-text hover:bg-lfe-action-secondary-hover transition-all text-sm no-underline">
              {{ build.link_text }} &raquo;
              </a>
            </div>
          </div>
        </div>
      </div>
      <!-- End Block -->
      {% endfor %}

    </div>
    <!-- End Col -->
  </div>
  <!-- End Grid -->
</div>
