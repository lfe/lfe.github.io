<div class="max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 mx-auto">
  <div class="flex w-full justify-center">
    <h1>{{ site.data.home.features.title }}</h1>
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-2 items-center gap-6 md:gap-10">

    {% for feature in site.data.home.features.items %}
    <div class="w-full h-full bg-lfe-panel shadow-lg rounded-md p-5">
      <div class="flex items-center gap-x-4 mb-3">
        <div
          class="inline-flex justify-center items-center w-[62px] h-[62px] rounded-full border-4 border-lfe-boundary bg-lfe-raised text-lfe-muted">
          {{ feature.icon_html }}
        </div>
        <div class="flex-shrink-0">
          <h3 class="block text-lg font-semibold text-lfe-primary">{{ feature.title_html }}</h3>
        </div>
      </div>
      <p class="text-lfe-secondary">{{ feature.content_html }}</p>
    </div>
    {% endfor %}

  </div>
</div>
