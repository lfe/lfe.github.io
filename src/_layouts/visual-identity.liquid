<!doctype html>
<html lang="en">
<head>
    {% include "meta.liquid" %}
    <title>(LFE:{{ page.title }})</title>
    <meta name="description" content="{{ page.description }}">
    {% include "favicon.liquid" %}
    {% include "css.liquid" %}
</head>
<body class="min-h-[75rem]">
    <header class="top-nav">{% include "nav.liquid" %}</header>
    <main id="content" role="main" tabindex="-1">
        <div class="masthead-container">
            <div class="masthead-section vi-masthead">
                <p class="vi-eyebrow">Working reference · Draft</p>
                <h1>{{ page.title }}</h1>
                <p class="vi-description">{{ page.description }}</p>
            </div>
        </div>
        <div class="content-section visual-identity-content">
            <div class="vi-shell">
                {% include "visual-identity/nav.liquid" %}
                {% if page.permalink == "visual-identity/colours/" %}
                    {% assign vi_palette_view = "quick" %}
                    {% include "visual-identity/palette.liquid" %}
                    <details class="vi-method-notes">
                        <summary>Method and source notes</summary>
                        <article class="vi-article">{{ page.content }}</article>
                    </details>
                    {% assign vi_palette_view = "detailed" %}
                    {% include "visual-identity/palette.liquid" %}
                {% else %}
                    <article class="vi-article">{{ page.content }}</article>
                    {% if page.permalink == "visual-identity/" %}
                        {% include "visual-identity/direction.liquid" %}
                    {% elsif page.permalink == "visual-identity/tokens/" %}
                        {% include "visual-identity/tokens.liquid" %}
                    {% elsif page.permalink == "visual-identity/themes/" %}
                        {% include "visual-identity/boards.liquid" %}
                    {% endif %}
                {% endif %}
            </div>
        </div>
    </main>
    {% include "foot.liquid" %}
    {% include "end-scripts.liquid" %}
</body>
</html>
