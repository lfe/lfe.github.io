<!-- Card Blog -->
<div class="max-w-[80rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 mx-auto">
  <div class="flex w-full justify-center">
    <h2>{{ site.data.home.books.title }}</h2>
  </div>

  <!-- Grid -->
  <div class="book-cards grid sm:grid-cols-2 lg:grid-cols-3 gap-6 gap-y-8">
    {% for book in site.data.home.books.items %}
    <div
      class="group flex flex-col h-full bg-lfe-panel border border-lfe-boundary shadow-sm rounded-md">
      <div class="h-108 flex flex-col justify-center items-center bg-blue-600 rounded-t-md">
        {{ book.cover_html }}
      </div>
      <div class="p-4 md:p-5">
        <span class="block mb-1 text-xs font-semibold uppercase text-lfe-link">
          {{ book.authors }}
        </span>
        <h3 class="text-xl font-semibold text-lfe-primary">
          {{ book.title }}
        </h3>
        {{ book.description_html }}
      </div>
      <div
        class="mt-auto flex border-t border-lfe-boundary divide-x divide-lfe-boundary">
        <div class="card-button card-action">
        <a class="w-full py-3 px-4 inline-flex justify-center items-center gap-2 rounded-bl-md font-medium bg-lfe-panel text-lfe-primary shadow-sm align-middle hover:bg-lfe-raised transition-all text-sm sm:p-4"
          href="{{ book.link_url }}">
          {{ book.link_text }}
        </a>
        </div>
        <div class="card-button">
        <a class="w-full py-3 px-4 inline-flex justify-center items-center gap-2 rounded-br-md font-medium bg-lfe-panel text-lfe-primary shadow-sm align-middle hover:bg-lfe-raised transition-all text-sm sm:p-4"
          href="{{ site.data.home.books.link_url }}">
          {{ site.data.home.books.link_text }}
        </a>
        </div>
      </div>
    </div>
    <!-- End Card -->
    {% endfor %}

  </div>
  <!-- End Grid -->
</div>
<!-- End Card Blog -->
