<div class="max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 mx-auto">
  <div class="flex w-full justify-center">
    <h2>{{ site.data.home.features.title }}</h2>
  </div>

  <div class="features-grid grid sm:grid-cols-2 lg:grid-cols-2 items-center gap-6 md:gap-10">

    {% for feature in site.data.home.features.items %}
    <div class="feature-card min-w-0 w-full h-full bg-lfe-panel shadow-lg rounded-md p-5">
      <div class="feature-header flex flex-wrap items-center gap-x-4 mb-3">
        <div
          class="feature-header-icon inline-flex shrink-0 justify-center items-center w-[62px] h-[62px] rounded-full border-4 bg-lfe-raised">
          {{ feature.icon_html }}
        </div>
        <div class="feature-header-title">
          <h3 class="block text-lg font-semibold">{{ feature.title_html }}</h3>
        </div>
      </div>
      <p class="text-lfe-secondary">{{ feature.content_html }}</p>
    </div>
    {% endfor %}

  </div>
</div>
